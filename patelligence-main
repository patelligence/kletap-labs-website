<script>
// ── NAVIGATION ──
function go(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('pg-' + page).classList.add('active');
  document.querySelectorAll('.nav-center a[data-p]').forEach(a => {
    a.classList.toggle('active', a.dataset.p === page);
  });
  window.scrollTo({ top: 0, behavior: 'instant' });
  setTimeout(initReveal, 80);
}

// ── MOBILE MENU ──
function toggleMob() {
  document.getElementById('mob').classList.toggle('open');
}

// ── NAV SCROLL ──
window.addEventListener('scroll', () => {
  document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 20);
});

// ── CURSOR ──
const cur = document.getElementById('cur');
const curRing = document.getElementById('curRing');
document.addEventListener('mousemove', e => {
  cur.style.left = e.clientX + 'px';
  cur.style.top = e.clientY + 'px';
  curRing.style.left = e.clientX + 'px';
  curRing.style.top = e.clientY + 'px';
});
document.querySelectorAll('button, a, .card, .blog-card').forEach(el => {
  el.addEventListener('mouseenter', () => curRing.style.transform = 'translate(-50%,-50%) scale(2)');
  el.addEventListener('mouseleave', () => curRing.style.transform = 'translate(-50%,-50%) scale(1)');
});

// ── PARTICLE CANVAS ──
(function() {
  const canvas = document.getElementById('particleCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, particles = [];
  function resize() { W = canvas.width = canvas.offsetWidth; H = canvas.height = canvas.offsetHeight; }
  resize();
  window.addEventListener('resize', resize);
  for (let i = 0; i < 80; i++) {
    particles.push({
      x: Math.random() * (W || 1200), y: Math.random() * (H || 800),
      vx: (Math.random() - .5) * .35, vy: (Math.random() - .5) * .35,
      r: Math.random() * 1.5 + .5, opacity: Math.random() * .5 + .2
    });
  }
  function draw() {
    ctx.clearRect(0, 0, W, H);
    particles.forEach(p => {
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0) p.x = W; if (p.x > W) p.x = 0;
      if (p.y < 0) p.y = H; if (p.y > H) p.y = 0;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(0,163,255,${p.opacity})`; ctx.fill();
      particles.forEach(q => {
        const dx = p.x - q.x, dy = p.y - q.y, d = Math.sqrt(dx*dx + dy*dy);
        if (d < 100) {
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y);
          ctx.strokeStyle = `rgba(0,163,255,${.15 * (1 - d/100)})`; ctx.lineWidth = .5; ctx.stroke();
        }
      });
    });
    requestAnimationFrame(draw);
  }
  draw();
})();

// ── DASHBOARD BARS ──
function buildBars() {
  const container = document.getElementById('dashBars');
  if (!container) return;
  const vals = [35,50,42,68,55,80,72,90,65,88,75,95,82,100];
  const colors = ['#00a3ff','#00ffcc'];
  container.innerHTML = '';
  vals.forEach((v,i) => {
    const b = document.createElement('div');
    b.className = 'fd-bar';
    b.style.cssText = `height:${v}%;background:linear-gradient(to top,${colors[0]},${colors[1]});opacity:${.5 + i/vals.length*.5};`;
    container.appendChild(b);
  });
}
buildBars();

// ── SCROLL REVEAL ──
function initReveal() {
  const els = document.querySelectorAll('.page.active .reveal');
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('up'); obs.unobserve(e.target); }});
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  els.forEach(el => { el.classList.remove('up'); obs.observe(el); });
  // Immediately reveal visible ones
  setTimeout(() => {
    document.querySelectorAll('.page.active .reveal').forEach(el => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight) el.classList.add('up');
    });
  }, 50);
}
initReveal();

// ── CHATBOT ──
function toggleChat() {
  document.getElementById('chatPop').classList.toggle('open');
}
const chatResponses = [
  "Great question! We can typically automate that within the first week of onboarding.",
  "Most of our clients save 15–25 hours per week with that specific workflow.",
  "I'd recommend booking a free discovery call so we can map out your exact process. Want me to help?",
  "That's one of our most popular automations! It works great for your type of business.",
  "Absolutely. We have a pre-built template for that. I can have it reviewed in your demo call."
];
function chatSend(e) { if (e.key === 'Enter') chatSendClick(); }
function chatSendClick() {
  const input = document.getElementById('chatInput');
  const msgs = document.getElementById('chatMsgs');
  const val = input.value.trim();
  if (!val) return;
  const userMsg = document.createElement('div');
  userMsg.className = 'chat-msg user'; userMsg.textContent = val;
  msgs.appendChild(userMsg);
  input.value = '';
  setTimeout(() => {
    const botMsg = document.createElement('div');
    botMsg.className = 'chat-msg bot';
    botMsg.textContent = chatResponses[Math.floor(Math.random() * chatResponses.length)];
    msgs.appendChild(botMsg);
    msgs.scrollTop = msgs.scrollHeight;
  }, 800);
  msgs.scrollTop = msgs.scrollHeight;
}

// ── NEWSLETTER ──
function handleNL(btn) {
  const p = btn.parentElement;
  const inp = p.querySelector('input[type=email]');
  if (inp && inp.value.includes('@')) {
    btn.textContent = '✓ Subscribed!';
    btn.style.background = 'linear-gradient(135deg,#059669,#34d399)'; btn.style.boxShadow = 'none';
    btn.disabled = true; inp.value = '';
    setTimeout(() => { btn.textContent = 'Subscribe →'; btn.style.background = ''; btn.disabled = false; }, 3000);
  } else {
    if (inp) { inp.style.borderColor = 'rgba(255,77,106,.5)'; setTimeout(() => inp.style.borderColor = '', 2000); }
  }
}

// ── FORM ──
function handleForm(btn) {
  btn.textContent = '✓ Submitted! We\'ll reach out within 2 hours.';
  btn.style.background = 'linear-gradient(135deg,#059669,#34d399)'; btn.style.boxShadow = 'none';
  btn.disabled = true;
  setTimeout(() => { btn.textContent = '⚡ Book My Free Consultation →'; btn.style.background = ''; btn.disabled = false; }, 4000);
}
</script>
