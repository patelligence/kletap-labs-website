<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Patelligence AI — AI Automation Built for Modern Businesses</title>
<meta name="description" content="Patelligence AI helps businesses automate workflows, eliminate repetitive tasks, and operate smarter with intelligent systems. Everyone needs some pAI in their life."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@300;400;500;600;700;800;900&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
/* ════════════════════════════════════════
   DESIGN SYSTEM — PATELLIGENCE AI
   Aesthetic: Surgical precision SaaS.
   Sharp grid, monospace accents, electric
   neon slicing through obsidian.
════════════════════════════════════════ */
:root {
  --void: #02020a;
  --ink: #080812;
  --panel: #0d0d1a;
  --raised: #111122;
  --lifted: #161628;
  --border: rgba(255,255,255,0.06);
  --border-hot: rgba(0,163,255,0.35);
  --neon: #00a3ff;
  --neon-dim: rgba(0,163,255,0.15);
  --neon-glow: rgba(0,163,255,0.3);
  --mint: #00ffcc;
  --mint-dim: rgba(0,255,204,0.1);
  --white: #f0f4ff;
  --silver: #a0a8c0;
  --mist: #5a6080;
  --danger: #ff4d6a;
  --success: #00e5a0;
  --warn: #ffb547;
  --r: 12px;
  --r-lg: 20px;
  --font-h: 'Epilogue', sans-serif;
  --font-b: 'Instrument Sans', sans-serif;
  --font-m: 'IBM Plex Mono', monospace;
  --transition: all .28s cubic-bezier(.4,0,.2,1);
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; font-size:16px; }
body { background:var(--void); color:var(--silver); font-family:var(--font-b); overflow-x:hidden; line-height:1.6; }
a { color:inherit; text-decoration:none; }
button { cursor:pointer; border:none; background:none; font-family:var(--font-b); }
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-track { background:var(--void); }
::-webkit-scrollbar-thumb { background:var(--neon); border-radius:2px; }

/* ── SCAN LINES OVERLAY ── */
body::before {
  content:'';
  position:fixed; inset:0; z-index:9998;
  background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,.03) 2px,rgba(0,0,0,.03) 4px);
  pointer-events:none;
}

/* ── CURSOR ── */
.cursor { position:fixed; width:6px; height:6px; background:var(--neon); border-radius:50%; pointer-events:none; z-index:9999; transform:translate(-50%,-50%); transition:transform .1s; mix-blend-mode:screen; }
.cursor-ring { position:fixed; width:28px; height:28px; border:1px solid rgba(0,163,255,.4); border-radius:50%; pointer-events:none; z-index:9997; transform:translate(-50%,-50%); transition:left .15s,top .15s,transform .3s; }

/* ── NAV ── */
nav {
  position:fixed; top:0; left:0; right:0; z-index:1000;
  height:64px; display:flex; align-items:center; justify-content:space-between;
  padding:0 5vw;
  transition:var(--transition);
}
nav.scrolled {
  background:rgba(2,2,10,.92);
  border-bottom:1px solid var(--border);
  backdrop-filter:blur(20px) saturate(1.5);
}
.nav-logo {
  display:flex; align-items:center; gap:10px;
  font-family:var(--font-h); font-weight:900; font-size:1.05rem; color:var(--white);
  letter-spacing:-.02em;
}
.logo-icon {
  width:34px; height:34px;
  background:linear-gradient(135deg,var(--neon),var(--mint));
  border-radius:8px;
  display:flex; align-items:center; justify-content:center;
  font-size:.75rem; font-weight:900; color:#000;
  letter-spacing:-.05em;
  box-shadow:0 0 16px var(--neon-glow);
}
.nav-center { display:flex; align-items:center; gap:1.8rem; }
.nav-center a {
  font-size:.82rem; font-weight:500; color:var(--mist);
  letter-spacing:.04em; text-transform:uppercase;
  transition:color .2s; position:relative;
}
.nav-center a::after {
  content:''; position:absolute; bottom:-4px; left:0; right:0; height:1px;
  background:var(--neon); transform:scaleX(0); transition:transform .2s;
}
.nav-center a:hover, .nav-center a.active { color:var(--white); }
.nav-center a:hover::after, .nav-center a.active::after { transform:scaleX(1); }
.nav-right { display:flex; align-items:center; gap:.75rem; }
.btn-ghost { padding:8px 18px; border:1px solid var(--border); border-radius:6px; font-size:.8rem; font-weight:500; color:var(--silver); transition:var(--transition); letter-spacing:.03em; }
.btn-ghost:hover { border-color:var(--border-hot); color:var(--white); }
.btn-neon { padding:8px 20px; background:var(--neon); border-radius:6px; font-size:.8rem; font-weight:700; color:#000; letter-spacing:.03em; transition:var(--transition); box-shadow:0 0 20px var(--neon-glow); }
.btn-neon:hover { background:var(--mint); box-shadow:0 0 30px rgba(0,255,204,.4); transform:translateY(-1px); }
.hamburger { display:none; flex-direction:column; gap:4px; cursor:pointer; padding:4px; }
.hamburger span { display:block; width:20px; height:1.5px; background:var(--white); transition:all .3s; }
.mobile-menu { display:none; position:fixed; top:64px; left:0; right:0; background:rgba(2,2,10,.98); backdrop-filter:blur(20px); padding:2rem 5vw; border-bottom:1px solid var(--border); z-index:999; flex-direction:column; gap:1.25rem; }
.mobile-menu a { font-size:1rem; color:var(--silver); padding:.5rem 0; border-bottom:1px solid var(--border); font-weight:500; }
.mobile-menu.open { display:flex; }

/* ── PAGES ── */
.page { display:none; min-height:100vh; }
.page.active { display:block; }

/* ── LAYOUT UTILS ── */
.container { padding:0 5vw; }
section { padding:6rem 5vw; }
section.tight { padding:4rem 5vw; }

/* ── TYPOGRAPHY ── */
.eyebrow {
  display:inline-flex; align-items:center; gap:8px;
  font-family:var(--font-m); font-size:.7rem; color:var(--neon);
  letter-spacing:.15em; text-transform:uppercase; margin-bottom:1.2rem;
}
.eyebrow::before { content:''; display:block; width:20px; height:1px; background:var(--neon); }
h1.display {
  font-family:var(--font-h); font-size:clamp(3rem,6.5vw,6rem);
  font-weight:900; color:var(--white); line-height:1.0; letter-spacing:-.04em;
}
h2.display {
  font-family:var(--font-h); font-size:clamp(2.2rem,4vw,3.8rem);
  font-weight:900; color:var(--white); line-height:1.05; letter-spacing:-.035em;
}
h3.card-title { font-family:var(--font-h); font-size:1.1rem; font-weight:800; color:var(--white); letter-spacing:-.02em; }
.gradient-text {
  background:linear-gradient(90deg,var(--neon),var(--mint));
  -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
}
.body-lg { font-size:1.1rem; color:var(--silver); line-height:1.75; font-weight:400; }
.body-sm { font-size:.875rem; color:var(--mist); line-height:1.7; }

/* ── BUTTONS ── */
.cta-primary {
  display:inline-flex; align-items:center; gap:10px;
  padding:14px 28px; background:var(--neon); color:#000;
  border-radius:8px; font-weight:700; font-size:.9rem;
  transition:var(--transition); box-shadow:0 0 30px var(--neon-glow);
  letter-spacing:.01em;
}
.cta-primary:hover { background:var(--mint); transform:translateY(-2px); box-shadow:0 0 50px rgba(0,255,204,.5); }
.cta-secondary {
  display:inline-flex; align-items:center; gap:10px;
  padding:14px 28px; border:1px solid var(--border);
  color:var(--white); border-radius:8px; font-weight:500; font-size:.9rem;
  transition:var(--transition);
}
.cta-secondary:hover { border-color:var(--border-hot); background:rgba(0,163,255,.05); transform:translateY(-2px); }

/* ── HERO ── */
.hero {
  position:relative; min-height:100vh;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  text-align:center; padding:120px 5vw 80px; overflow:hidden;
}
.hero-bg { position:absolute; inset:0; z-index:0; }
.hero-grid-lines {
  position:absolute; inset:0;
  background-image:
    linear-gradient(rgba(0,163,255,.03) 1px, transparent 1px),
    linear-gradient(90deg,rgba(0,163,255,.03) 1px, transparent 1px);
  background-size:40px 40px;
  mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,black 40%,transparent 100%);
}
.hero-orb {
  position:absolute; border-radius:50%;
  filter:blur(80px); opacity:.25; animation:breathe 6s ease-in-out infinite;
}
.hero-orb-1 { width:600px; height:600px; background:radial-gradient(circle,var(--neon),transparent); top:10%; left:50%; transform:translateX(-50%); }
.hero-orb-2 { width:300px; height:300px; background:radial-gradient(circle,var(--mint),transparent); top:40%; right:10%; animation-delay:2s; }
.hero-orb-3 { width:250px; height:250px; background:radial-gradient(circle,#6030ff,transparent); top:30%; left:5%; animation-delay:4s; }
@keyframes breathe { 0%,100%{opacity:.2;transform:translateX(-50%) scale(1);} 50%{opacity:.35;transform:translateX(-50%) scale(1.15);} }
.hero-content { position:relative; z-index:2; max-width:900px; }
.pai-badge {
  display:inline-flex; align-items:center; gap:6px;
  padding:5px 14px 5px 10px;
  border:1px solid var(--border-hot);
  background:rgba(0,163,255,.06);
  border-radius:100px; margin-bottom:2.5rem;
  font-family:var(--font-m); font-size:.7rem; color:var(--neon);
  letter-spacing:.1em;
}
.pai-pulse { width:6px; height:6px; border-radius:50%; background:var(--neon); box-shadow:0 0 6px var(--neon); animation:blink 1.5s infinite; }
@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.2;} }
.hero-sub-wrap { max-width:640px; margin:1.5rem auto 3rem; }
.hero-btns { display:flex; align-items:center; justify-content:center; gap:1rem; flex-wrap:wrap; }

/* ── DASHBOARD MOCKUP ── */
.dashboard-mockup {
  position:relative; z-index:2; margin-top:5rem;
  max-width:900px; margin-left:auto; margin-right:auto;
}
.dash-chrome {
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:var(--r-lg);
  overflow:hidden;
  box-shadow:0 40px 120px rgba(0,0,0,.8), 0 0 60px rgba(0,163,255,.1);
}
.dash-titlebar {
  background:var(--raised);
  padding:.6rem 1rem;
  display:flex; align-items:center; gap:.5rem;
  border-bottom:1px solid var(--border);
}
.dash-dot { width:10px; height:10px; border-radius:50%; }
.dash-dot-r { background:#ff5f57; }
.dash-dot-y { background:#febc2e; }
.dash-dot-g { background:#28c840; }
.dash-url { flex:1; margin-left:1rem; padding:4px 12px; background:var(--lifted); border-radius:4px; font-family:var(--font-m); font-size:.68rem; color:var(--mist); }
.dash-body { display:grid; grid-template-columns:200px 1fr; height:380px; }
.dash-sidebar { background:var(--raised); border-right:1px solid var(--border); padding:1rem 0; }
.dash-sidebar-item { padding:.5rem 1.25rem; font-size:.75rem; color:var(--mist); display:flex; align-items:center; gap:.6rem; cursor:pointer; transition:var(--transition); }
.dash-sidebar-item:hover, .dash-sidebar-item.active { background:rgba(0,163,255,.08); color:var(--white); }
.dash-sidebar-item.active { border-right:2px solid var(--neon); }
.dash-sidebar-icon { font-size:.85rem; }
.dash-main { padding:1.25rem; display:flex; flex-direction:column; gap:1rem; overflow:hidden; }
.dash-kpi-row { display:grid; grid-template-columns:repeat(4,1fr); gap:.75rem; }
.dash-kpi {
  background:var(--raised); border:1px solid var(--border); border-radius:10px;
  padding:.85rem; position:relative; overflow:hidden;
}
.dash-kpi::after { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg,var(--neon),var(--mint)); }
.dash-kpi-label { font-family:var(--font-m); font-size:.6rem; color:var(--mist); letter-spacing:.08em; text-transform:uppercase; margin-bottom:.3rem; }
.dash-kpi-val { font-family:var(--font-h); font-size:1.3rem; font-weight:900; color:var(--white); }
.dash-kpi-delta { font-size:.65rem; color:var(--success); margin-top:.2rem; }
.dash-charts { display:grid; grid-template-columns:1.4fr 1fr; gap:.75rem; flex:1; }
.dash-chart-card { background:var(--raised); border:1px solid var(--border); border-radius:10px; padding:.85rem; }
.dash-chart-label { font-size:.7rem; color:var(--mist); font-family:var(--font-m); margin-bottom:.6rem; }
.mini-chart { display:flex; align-items:flex-end; gap:3px; height:60px; }
.mini-bar { flex:1; border-radius:3px 3px 0 0; background:linear-gradient(to top,var(--neon),var(--mint)); opacity:.7; transition:opacity .2s; }
.mini-bar:hover { opacity:1; }
.mini-line { width:100%; height:60px; position:relative; }
.mini-line svg { width:100%; height:100%; }
.dash-ai-panel { background:rgba(0,163,255,.06); border:1px solid var(--border-hot); border-radius:10px; padding:.85rem; display:flex; flex-direction:column; gap:.5rem; }
.dash-ai-header { font-family:var(--font-m); font-size:.65rem; color:var(--neon); letter-spacing:.1em; }
.dash-ai-msg { font-size:.72rem; color:var(--silver); padding:.4rem .6rem; background:var(--raised); border-radius:6px; border-left:2px solid var(--neon); }
.dash-ai-input { margin-top:auto; padding:.5rem .75rem; background:var(--lifted); border-radius:6px; font-size:.7rem; color:var(--mist); font-family:var(--font-m); border:1px solid var(--border); }
/* animated typing dots */
.typing { display:inline-flex; gap:3px; align-items:center; padding:.3rem .5rem; }
.typing span { width:4px; height:4px; border-radius:50%; background:var(--neon); animation:typedot .8s infinite; }
.typing span:nth-child(2) { animation-delay:.15s; }
.typing span:nth-child(3) { animation-delay:.3s; }
@keyframes typedot { 0%,80%,100%{opacity:.2;transform:scale(.8);} 40%{opacity:1;transform:scale(1.2);} }

/* ── LOGOS ── */
.logos-strip { padding:2.5rem 5vw; border-top:1px solid var(--border); border-bottom:1px solid var(--border); background:var(--ink); }
.logos-label { font-family:var(--font-m); font-size:.68rem; color:var(--mist); letter-spacing:.12em; text-transform:uppercase; text-align:center; margin-bottom:1.5rem; }
.logos-row { display:flex; align-items:center; justify-content:center; gap:2.5rem; flex-wrap:wrap; }
.logo-pill { padding:.5rem 1.25rem; border:1px solid var(--border); border-radius:6px; font-family:var(--font-h); font-size:.8rem; font-weight:700; color:var(--mist); letter-spacing:.05em; }

/* ── CARDS ── */
.card { background:var(--panel); border:1px solid var(--border); border-radius:var(--r-lg); transition:var(--transition); position:relative; overflow:hidden; }
.card::before { content:''; position:absolute; inset:0; background:linear-gradient(135deg,rgba(0,163,255,.04),transparent); opacity:0; transition:opacity .3s; }
.card:hover { border-color:var(--border-hot); transform:translateY(-4px); box-shadow:0 20px 60px rgba(0,0,0,.6),0 0 30px rgba(0,163,255,.08); }
.card:hover::before { opacity:1; }
.card-pad { padding:2rem; }

/* ── FEATURE GRID ── */
.feature-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.5rem; }
.feature-icon { width:44px; height:44px; border-radius:10px; background:rgba(0,163,255,.1); border:1px solid rgba(0,163,255,.2); display:flex; align-items:center; justify-content:center; font-size:1.1rem; margin-bottom:1.25rem; }

/* ── STATS ── */
.stats-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:0; }
.stat-cell { padding:3rem 2rem; text-align:center; border-right:1px solid var(--border); border-bottom:1px solid var(--border); }
.stat-cell:last-child { border-right:none; }
.stat-num { font-family:var(--font-h); font-size:clamp(2.5rem,5vw,4rem); font-weight:900; color:var(--white); letter-spacing:-.04em; line-height:1; }
.stat-unit { color:var(--neon); }
.stat-desc { font-size:.82rem; color:var(--mist); margin-top:.5rem; }

/* ── SECTION HEADER ── */
.sh { margin-bottom:4rem; }
.sh.center { text-align:center; }
.sh.center .body-lg { max-width:580px; margin:1rem auto 0; }

/* ── SOLUTIONS ── */
.solution-row { display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:center; padding:4rem 0; border-bottom:1px solid var(--border); }
.solution-row:last-child { border-bottom:none; }
.solution-row.flip { direction:rtl; }
.solution-row.flip > * { direction:ltr; }
.solution-visual { background:var(--panel); border:1px solid var(--border); border-radius:var(--r-lg); padding:1.75rem; }
.workflow-steps { display:flex; flex-direction:column; gap:.6rem; }
.w-step { display:flex; align-items:center; gap:.75rem; padding:.65rem .85rem; border-radius:8px; background:var(--raised); border:1px solid var(--border); font-size:.8rem; }
.w-step-num { width:20px; height:20px; border-radius:50%; background:var(--neon); color:#000; font-size:.62rem; font-weight:900; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.w-step-label { color:var(--silver); flex:1; }
.w-step-status { font-family:var(--font-m); font-size:.62rem; padding:2px 8px; border-radius:100px; }
.ws-done { background:rgba(0,229,160,.1); color:var(--success); }
.ws-run { background:rgba(0,163,255,.1); color:var(--neon); animation:pulse-text 1.5s infinite; }
.ws-wait { background:rgba(255,181,71,.08); color:var(--warn); }
@keyframes pulse-text { 0%,100%{opacity:.6;} 50%{opacity:1;} }
.solution-metrics { display:grid; grid-template-columns:1fr 1fr; gap:.75rem; margin-top:1rem; }
.s-metric { padding:.85rem; background:var(--raised); border-radius:8px; border:1px solid var(--border); text-align:center; }
.s-metric-val { font-family:var(--font-h); font-size:1.5rem; font-weight:900; color:var(--neon); }
.s-metric-label { font-size:.72rem; color:var(--mist); margin-top:.2rem; }
.integration-chips { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:1rem; }
.chip { padding:4px 12px; border-radius:100px; background:var(--raised); border:1px solid var(--border); font-size:.72rem; color:var(--silver); font-family:var(--font-m); }

/* ── INDUSTRIES ── */
.industries-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:1.5rem; }
.ind-card { background:var(--panel); border:1px solid var(--border); border-radius:var(--r-lg); padding:2rem; transition:var(--transition); }
.ind-card:hover { border-color:var(--border-hot); transform:translateY(-4px); }
.ind-emoji { font-size:2rem; margin-bottom:1rem; }
.ind-card h3 { font-family:var(--font-h); font-weight:800; color:var(--white); margin-bottom:.75rem; font-size:1.05rem; }
.pain-list { list-style:none; margin-bottom:1.25rem; }
.pain-list li { font-size:.8rem; color:var(--mist); padding:.25rem 0; display:flex; align-items:flex-start; gap:.5rem; }
.pain-list li::before { content:'✗'; color:var(--danger); font-size:.7rem; margin-top:.1rem; flex-shrink:0; }
.solution-list { list-style:none; }
.solution-list li { font-size:.8rem; color:var(--silver); padding:.25rem 0; display:flex; align-items:flex-start; gap:.5rem; }
.solution-list li::before { content:'✓'; color:var(--success); font-size:.7rem; margin-top:.1rem; flex-shrink:0; }
.impact-bar { margin-top:1.25rem; padding:.75rem; background:var(--raised); border-radius:8px; border-left:2px solid var(--neon); font-size:.75rem; color:var(--neon); font-family:var(--font-m); }

/* ── DEMO DASHBOARD ── */
.full-dashboard { background:var(--panel); border:1px solid var(--border); border-radius:var(--r-lg); overflow:hidden; box-shadow:0 40px 120px rgba(0,0,0,.8); }
.fd-topbar { background:var(--raised); padding:1rem 1.5rem; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); }
.fd-topbar-left { display:flex; align-items:center; gap:.5rem; }
.fd-tabs { display:flex; gap:.25rem; }
.fd-tab { padding:.4rem .9rem; border-radius:6px; font-size:.75rem; font-weight:500; cursor:pointer; transition:var(--transition); color:var(--mist); }
.fd-tab.active { background:rgba(0,163,255,.12); color:var(--neon); }
.fd-topbar-right { display:flex; align-items:center; gap:.75rem; }
.notif-badge { position:relative; display:inline-flex; }
.notif-dot { position:absolute; top:-2px; right:-2px; width:8px; height:8px; border-radius:50%; background:var(--danger); }
.fd-avatar { width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,var(--neon),var(--mint)); display:flex; align-items:center; justify-content:center; font-size:.65rem; font-weight:900; color:#000; }
.fd-body { display:grid; grid-template-columns:220px 1fr 260px; min-height:550px; }
.fd-sidebar { background:rgba(8,8,18,.5); border-right:1px solid var(--border); padding:1.25rem 0; }
.fd-nav-section { margin-bottom:1.5rem; }
.fd-nav-label { font-family:var(--font-m); font-size:.6rem; color:var(--mist); letter-spacing:.12em; padding:.25rem 1.25rem .5rem; }
.fd-nav-item { display:flex; align-items:center; gap:.65rem; padding:.6rem 1.25rem; font-size:.78rem; color:var(--mist); cursor:pointer; transition:var(--transition); }
.fd-nav-item:hover,.fd-nav-item.active { background:rgba(0,163,255,.08); color:var(--white); }
